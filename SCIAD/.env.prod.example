# ============================================================
# SCIAD — Variables de PRODUCCIÓN (plantilla)
# Copia a `.env.prod` y rellena valores REALES. `.env.prod`
# NO se versiona (ver .gitignore). Uso:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=sciad
POSTGRES_USER=sciad
# GENERA una contraseña fuerte:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me-strong-password
# Conexiones concurrentes (ver DESPLIEGUE.md §2.3)
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_MAX_POOL=200

# --- Backend (JWT) ---
# Mínimo 32 chars (fail-fast). Genera:  openssl rand -base64 48
SCIAD_JWT_SECRET=change-me-a-very-long-secret-key-of-at-least-32-chars

# Origen CORS (mismo dominio del SPA; separar con comas)
SCIAD_CORS_ORIGINS=https://sciad.gt

# Rate limit de login (SEC-04)
RATE_LIMIT_LOGIN_PERMIT=5
RATE_LIMIT_LOGIN_WINDOW=300