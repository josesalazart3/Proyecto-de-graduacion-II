# ============================================================
# SCIAD — Variables de entorno de desarrollo (docker compose)
# Copia este archivo a `.env` y ajusta los valores locales.
# NUNCA versionar `.env` (secretos reales).
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=sciad
POSTGRES_USER=sciad
POSTGRES_PASSWORD=change-me-sciad
# Conexiones concurrentes (carga 300 escaneos simultáneos, RNF-04):
#   POSTGRES_MAX_CONNECTIONS → max_connections de PostgreSQL
#   POSTGRES_MAX_POOL        → Maximum Pool Size de Npgsql
# Pool razonable (>100 sin inundar a PG; con 300 concurrentes y pool 400 el P95
# empeora porque el cuello es el propio PostgreSQL).
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_MAX_POOL=150
# --- Backend (JWT) ---
# Mínimo 32 caracteres (fail-fast en arranque). Genera uno así:
#   openssl rand -base64 48
SCIAD_JWT_SECRET=change-me-a-very-long-secret-key-of-at-least-32-chars
# Orígenes permitidos por CORS (separados por coma)
SCIAD_CORS_ORIGINS=http://localhost:8080,http://localhost:4200
