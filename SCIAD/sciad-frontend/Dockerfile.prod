# ============================================================
# SCIAD — Frontend (Angular) — imagen de PRODUCCIÓN
# Igual multi-stage que el Dockerfile de desarrollo, pero con la
# configuración de nginx TLS (nginx.prod.conf) horneada.
# Build: docker compose -f docker-compose.prod.yml build frontend
# ============================================================

# ---- Etapa 1: build ----
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build -- --configuration production

# ---- Etapa 2: servidor web ----
FROM nginx:1.27-alpine

# Configuración de producción: TLS + SPA fallback + proxy /api
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

# App compilada
COPY --from=build /app/dist/sciad-frontend/browser /usr/share/nginx/html

EXPOSE 80 443
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/.well-known/acme-challenge/ >/dev/null 2>&1 || exit 1